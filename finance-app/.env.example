# --- App ---
# Demo mode uses fake generated data and needs no bank/Plaid/Anthropic keys for the dashboard.
DEMO_MODE=true
# REQUIRED when DEMO_MODE=false. Login password for the (single-user) app.
APP_PASSWORD=
# Random secret used to sign session cookies:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Encrypts Plaid access tokens at rest:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Where the SQLite file lives (put this on a persistent volume in the cloud)
DB_PATH=./data/finance.db

# --- Anthropic (the chat agent) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
# Required for OAuth banks (Chase, Fidelity, Vanguard). Must be https and registered in the Plaid dashboard.
PLAID_REDIRECT_URI=
